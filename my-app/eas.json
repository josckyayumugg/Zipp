{
  "cli": {
    "version": ">= 21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },

    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },

    "preview": {
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "env": {
           "GOOGLE_SERVICES_JSON": "@secret:GOOGLE_SERVICES_JSON"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
